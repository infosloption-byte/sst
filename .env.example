# Where gallery images and videos are loaded from.
#
# Default (variable not set): https://southernstartattoo.info
#   Images/videos are loaded from the current live Laravel site, so the app
#   works immediately without copying any media.
#
# Once you have copied the media into ./public (see README), set this to an
# empty value so everything is served from the new site itself:
#   VITE_ASSET_BASE=
VITE_ASSET_BASE=

# Optional: endpoint that receives the "Stay in the Know" mailing-list signup
# as JSON: { "email": "..." }. When empty, the form opens a pre-filled email
# to the studio instead.
VITE_NEWSLETTER_ENDPOINT=
